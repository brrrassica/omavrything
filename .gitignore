# Rust build artifacts
/target
**/*.rs.bk

# Release binaries staged by scripts/build.sh (the release archive layout)
/bin

# Release binaries staged into the plugin tree by scripts/build.sh. A bare clone
# has none, so the plugin fetches the release asset on first run
# (scripts/fetch-daemon.sh); a local build is preferred when present.
/shell/omavrything/bin

# Release archives
/dist

# Built documentation site (site/build.py output)
/site/dist/
_site/

# CI dependency/build caches (actions/cache restores these into the workspace)
/.ci-cargo
/.ci-rustup
/.ci-target
# prepare-release.yml's CARGO_TARGET_DIR; target/ is symlinked to it, and both
# must stay out of the tree so the archive-input fingerprint cannot see them.
/.gate-target

# Fuzzing artifacts
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# Planning documents (kept local, not published)
/plans
/obsolete-plans
/old-rc

# Editor / OS noise
.DS_Store
*.swp

# Python build noise (site generator)
__pycache__/
*.pyc
