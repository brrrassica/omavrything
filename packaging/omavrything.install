# pacman install scriptlet for the omavrything package.
#
# Creates the dedicated `omavrything` user/group from the sysusers drop-in and
# reloads systemd so the new unit is visible. The daemon is deliberately not
# enabled: the user decides whether to run it as a system service or as a user
# process (see docs/install.md).

post_install() {
  systemd-sysusers
  # Create /run/omavrything and /var/lib/omavrything with the daemon's
  # ownership. The state directory holds the index snapshot and the state
  # config; without it the daemon cannot persist either.
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/omavrything.conf
  systemctl daemon-reload
  # Reload the system bus so it picks up the new policy; a bus that was already
  # running before the install does not see it otherwise, and the daemon cannot
  # own its name (ServiceUnknown: The name is not activatable).
  dbus-send --system --type=method_call --dest=org.freedesktop.DBus \
    /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 ||
    systemctl reload dbus >/dev/null 2>&1 || true
  cat <<'EOF'
==> omavrything installed.

To use the search UI, install the omarchy-shell plugin for your user:

    plugin=~/.config/omarchy/plugins/tech.alatcerdas.omavrything
    mkdir -p "$plugin/shell/omavrything"
    install -m644 /usr/share/omavrything/manifest.json "$plugin/manifest.json"
    install -m644 /usr/share/omavrything/shell/omavrything/*.qml \
      "$plugin/shell/omavrything/"
    omarchy restart shell   # the shell must rescan before it knows the plugin
    omarchy plugin enable tech.alatcerdas.omavrything --section center

To run the daemon as a hardened system service:

    sudo systemctl enable --now omavrythingd
    sudo usermod -aG omavrything "$USER"   # so the shell can reach the socket

Log out and back in for the group change to take effect. See
/usr/share/doc/omavrything/install.md for the full setup.
EOF
}

post_upgrade() {
  systemd-sysusers
  # Recreate the runtime and state directories in case the previous package
  # version did not ship the /var/lib/omavrything tmpfiles entry.
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/omavrything.conf
  systemctl daemon-reload
  # Reload the system bus so it picks up any policy change in the new version.
  dbus-send --system --type=method_call --dest=org.freedesktop.DBus \
    /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 ||
    systemctl reload dbus >/dev/null 2>&1 || true
  cat <<'EOF'
==> omavrything upgraded.

If the daemon is running as a system service, restart it to pick up the new
binary:

    sudo systemctl restart omavrythingd

Re-copy the shell plugin into ~/.config/omarchy/plugins/tech.alatcerdas.omavrything/
(see the post-install message), then restart the shell so the new QML is
compiled.
EOF
}

pre_remove() {
  systemctl stop omavrythingd.service 2>/dev/null || true
}
