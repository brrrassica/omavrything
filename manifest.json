{
  "schemaVersion": 1,
  "id": "tech.alatcerdas.omavrything",
  "name": "Omavrything",
  "version": "0.2.1",
  "author": "Sam Ralial",
  "license": "MIT",
  "description": "Instant, index-backed file search for Omarchy — Everything for Linux.",
  "kinds": ["bar-widget", "overlay", "service"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "shell/omavrything/SearchBar.qml",
    "overlay": "shell/omavrything/SearchOverlay.qml",
    "service": "shell/omavrything/Service.qml"
  },
  "barWidget": {
    "displayName": "Omavrything",
    "description": "Instant file search",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "backgroundOpacity": 0.75,
      "widthFraction": 0.7,
      "heightFraction": 0.7,
      "maxWidth": 1200,
      "maxHeight": 800,
      "maxResults": 200
    },
    "schema": [
      { "key": "backgroundOpacity", "type": "number", "label": "Tile opacity" },
      { "key": "widthFraction", "type": "number", "label": "Width fraction" },
      { "key": "heightFraction", "type": "number", "label": "Height fraction" },
      { "key": "maxWidth", "type": "number", "label": "Max width" },
      { "key": "maxHeight", "type": "number", "label": "Max height" },
      { "key": "maxResults", "type": "number", "label": "Max results" }
    ]
  }
}
